% function [output] = vdp1(t,y,mu)
% 
%     dy_1 = y(2,1);
%     dy_2 = mu * (1 - y(1,1)^2) * y(2,1) - y(1,1);
% 
%     output = [dy_1; dy_2];
% 
% end

t = 0;
A = [];
for mu = -2:0.01:2

    [x, fval, exitf, output, J] = fsolve(@(y)vdp1(t,y,mu),[2;0]);
    
    A = [A; mu, max(real(eig(J)))];

end

%plot(A(:,1), A(:,2), '-m')

